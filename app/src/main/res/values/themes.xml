<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NoirXBoost" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/noir_black</item>
        <item name="android:navigationBarColor">@color/noir_black</item>
        <item name="android:windowBackground">@color/noir_black</item>
    </style>

    <!-- Splash screen theme: dipakai sesaat saat app dibuka, sebelum Compose UI render -->
    <style name="Theme.NoirXBoost.Splash" parent="Theme.NoirXBoost">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>

</resources>
